# Copy to .env and fill in. Vite builds it into the page, so none of this is
# secret - it is kept out of the repository only so each copy names its own.

# The OAuth client id of a Google Cloud project with the Drive API enabled,
# whose authorised JavaScript origins include http://localhost:4173,
# http://localhost:5173 and the published site. Without it the trainer has no
# Google Drive sync; everything else works.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
